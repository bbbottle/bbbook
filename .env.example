# API server
API_PORT=80

# Kindle SSH connection (uses the local OpenSSH alias, e.g. `ssh kindle`)
KINDLE_SSH_CMD=ssh kindle
KINDLE_CONNECTION_TIMEOUT=10000

# Local storage path for uploads, screenshots and backups
STORAGE_PATH=/storage/bbbook

# Auth
# Required: 32+ byte secret used to sign temporary and session JWTs
AUTH_JWT_SECRET=change-me-in-production
# Optional: base64-encoded 32-byte AES-256 key for encrypting TOTP secrets at rest
AUTH_TOTP_SECRET_KEY=
# Optional: initial admin password for first-time seeding
AUTH_DEFAULT_ADMIN_PASSWORD=
# Optional: JSON array of { username, password } to seed on first start
AUTH_SEED_USERS=
# Optional: TOTP issuer shown in authenticator apps (default: bbbook)
AUTH_TOTP_ISSUER=bbbook

# z-library
ZLIBRARY_API_KEY=
